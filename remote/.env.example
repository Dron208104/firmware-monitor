DATABASE_URL=sqlite:////data/firmware-monitor.db
# Уникальный Fernet-ключ. После сохранения секретов менять его без процедуры ротации нельзя.
ENCRYPTION_KEY=replace-with-generated-fernet-key
APP_NAME=Firmware Monitor
APP_VERSION=1.1.0
TZ=Europe/Moscow
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
FIRMWARE_MONITOR_IMAGE=firmware-monitor:1.1.0
COMPOSE_PROJECT_NAME=firmware-monitor
SESSION_LIFETIME_HOURS=12
SESSION_INACTIVITY_MINUTES=15
# Включайте только при доступе к приложению по HTTPS.
SESSION_COOKIE_SECURE=false
AUTH_DISABLED=false

# Необязательный однократный bootstrap. Безопаснее использовать app.manage create-admin.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=replace-with-strong-password
